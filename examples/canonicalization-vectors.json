{
  "$comment": "Shared canonicalization test vectors for mandatepatch/profile/v1. Regenerate with scripts/build-vectors.py. The TypeScript and Python ports MUST both reproduce every expected_jcs and expected_digest byte for byte, and MUST both raise the named error code for every reject vector.",
  "profile": "mandatepatch/profile/v1",
  "serialization": "RFC 8785 JSON Canonicalization Scheme (JCS)",
  "hash": "SHA-256 over the UTF-8 bytes of the canonical string, base64url without padding, prefixed 'sha-256:'",
  "vectors": [
    {
      "name": "empty-object",
      "mode": "value",
      "note": "The base case: SHA-256 over the two bytes '{}'.",
      "input": {},
      "expected_jcs": "{}",
      "expected_digest": "sha-256:RBNvo1WzZ4oRRq0W9-hknpT7T8If536DEMBg9hyq_4o"
    },
    {
      "name": "nulls-booleans-empty-containers",
      "mode": "value",
      "note": "Explicit null is a value, not an omission. Profile v1 requires explicit null over omission throughout the 4.3 schema so that 'omitted-field drift is thereby within the scope of the hash'.",
      "input": {
        "a": null,
        "b": true,
        "c": false,
        "d": [],
        "e": {}
      },
      "expected_jcs": "{\"a\":null,\"b\":true,\"c\":false,\"d\":[],\"e\":{}}",
      "expected_digest": "sha-256:31kCrkAH-li4YnPcskkp53uS3n8VzvSW2__HsT2nCO0"
    },
    {
      "name": "key-order-ascii",
      "mode": "value",
      "note": "RFC 8785 sorts object member names by UTF-16 code unit, not by any locale collation: digits before uppercase before lowercase.",
      "input": {
        "b": 1,
        "A": 2,
        "a": 3,
        "10": 4,
        "1": 5
      },
      "expected_jcs": "{\"1\":5,\"10\":4,\"A\":2,\"a\":3,\"b\":1}",
      "expected_digest": "sha-256:GbOWwgS9CiQEZ8cyPr4y7GHojKVnA8Qx4Vu5shptDGQ"
    },
    {
      "name": "key-order-utf16-astral",
      "mode": "value",
      "note": "The discriminator between UTF-16 code-unit ordering and code-point ordering: U+10000 and above begin with a high surrogate (0xD800..0xDBFF), so they sort BEFORE U+E000 and U+FFFD in UTF-16 order and AFTER them by code point. Python's native string comparison gets this wrong; the port sorts on big-endian UTF-16 bytes instead.",
      "input": {
        "\ufffd\ufffd": "two-replacement-chars",
        "\ud83d\ude00": "astral",
        "a": "ascii",
        "\ue000": "bmp-pua"
      },
      "expected_jcs": "{\"a\":\"ascii\",\"\ud83d\ude00\":\"astral\",\"\ue000\":\"bmp-pua\",\"\ufffd\ufffd\":\"two-replacement-chars\"}",
      "expected_digest": "sha-256:J-aTDj1rlQvMDZAzO5LxLmtwxNmHNNxfnsT6pl66iGI"
    },
    {
      "name": "nfc-normalization",
      "mode": "value",
      "note": "PROFILE-DEFINED: v1 normalizes every key and every string value to NFC. Decomposed input hashes identically to precomposed input.",
      "input": {
        "e\u0301cole": "cafe\u0301",
        "stra\u00dfe": "gru\u0308n"
      },
      "expected_jcs": "{\"stra\u00dfe\":\"gr\u00fcn\",\"\u00e9cole\":\"caf\u00e9\"}",
      "expected_digest": "sha-256:3NZ73wyjEYSE-93cJw18F5DDwT7yZqlbCI7hDZL67p8"
    },
    {
      "name": "string-escapes",
      "mode": "value",
      "note": "RFC 8785 3.2.2.2 escaping: named escapes for the five, backslash-u00xx lowercase hex below 0x20, and nothing else escaped - not the solidus, not DEL, not non-ASCII.",
      "input": {
        "named": "\b\t\n\f\r",
        "ctrl": "\u0000\u0001\u001f",
        "quote": "\"",
        "backslash": "\\",
        "solidus": "/",
        "del": "\u007f",
        "nbsp": "\u00a0"
      },
      "expected_jcs": "{\"backslash\":\"\\\\\",\"ctrl\":\"\\u0000\\u0001\\u001f\",\"del\":\"\u007f\",\"named\":\"\\b\\t\\n\\f\\r\",\"nbsp\":\"\u00a0\",\"quote\":\"\\\"\",\"solidus\":\"/\"}",
      "expected_digest": "sha-256:G98ojytjbU_J8UMJt8CWB9sazNcDrgRmmb2L4Tb4D8I"
    },
    {
      "name": "integers",
      "mode": "value",
      "note": "PROFILE-DEFINED: v1 admits integers only. An integer-valued float is accepted and serialized as an integer; -0 normalizes to 0. Non-integer numbers are rejected.",
      "input": {
        "max": 9007199254740991,
        "min": -9007199254740991,
        "zero": 0,
        "negzero": -0.0,
        "int_valued_float": 100.0
      },
      "expected_jcs": "{\"int_valued_float\":100,\"max\":9007199254740991,\"min\":-9007199254740991,\"negzero\":0,\"zero\":0}",
      "expected_digest": "sha-256:c0uLIsdSK0RxDTnT6QkUrAENVu0uMtsDlDLKJxJFAN4"
    },
    {
      "name": "array-order-preserved",
      "mode": "value",
      "note": "RFC 8785 leaves array order alone. Profile v1 reorders only 'line_items', and only in canonical_commitment(); every other array is order-significant.",
      "input": {
        "list": [
          3,
          1,
          2
        ],
        "objs": [
          {
            "b": 1,
            "a": 2
          },
          {
            "d": 4,
            "c": 3
          }
        ]
      },
      "expected_jcs": "{\"list\":[3,1,2],\"objs\":[{\"a\":2,\"b\":1},{\"c\":3,\"d\":4}]}",
      "expected_digest": "sha-256:LTXylbztuRi0Olye_RvZgK9XGojN7cpzHxbBd5TUja0"
    },
    {
      "name": "unicode-values-literal",
      "mode": "value",
      "note": "Non-ASCII output is literal UTF-8, never backslash-u escaped. The hash is over the UTF-8 bytes of that string.",
      "input": {
        "cjk": "\u65e5\u672c\u8a9e",
        "emoji": "\ud83d\ude42",
        "rtl": "\u0645\u0631\u062d\u0628\u0627"
      },
      "expected_jcs": "{\"cjk\":\"\u65e5\u672c\u8a9e\",\"emoji\":\"\ud83d\ude42\",\"rtl\":\"\u0645\u0631\u062d\u0628\u0627\"}",
      "expected_digest": "sha-256:NJzK2CZRe_Jsjrv8NTu1v5-yojSDgDBaFLh5WjK089k"
    },
